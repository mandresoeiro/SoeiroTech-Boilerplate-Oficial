# Exemplo de variaveis de ambiente para o projeto Django.

SECRET_KEY=changeme
# Chave secreta do Django. Gere uma nova para producao.

DEBUG=True
# Use True em desenvolvimento e False em producao.

ALLOWED_HOSTS=localhost,127.0.0.1
# Hosts permitidos, separados por virgula.

DATABASE_URL=sqlite:///db.sqlite3
# Use PostgreSQL em producao. Exemplo: postgres://user:password@localhost:5432/dbname

TIME_ZONE=America/Fortaleza
# Fuso horario do projeto.

LOG_LEVEL=INFO
# Nivel de log: DEBUG, INFO, WARNING, ERROR ou CRITICAL.
